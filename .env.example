# Databricks Genie
DATABRICKS_HOST=dbc-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
GENIE_SPACE_ID=xxxx

# App security — must be changed in production (32+ chars)
SECRET_KEY=change-me-in-production-secret-key-min-32-chars!!

# Database (default: SQLite for local dev)
# For production on Cloud Run, use Cloud SQL:
# DATABASE_URL=postgresql+psycopg2://user:password@/dbname?host=/cloudsql/project:region:instance
DATABASE_URL=sqlite:///./genie.db
